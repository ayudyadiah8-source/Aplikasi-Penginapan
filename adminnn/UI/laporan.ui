<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AdminReportApp</class>

 <widget class="QWidget" name="AdminReportApp">
  <property name="geometry">
   <rect>
    <x>0</x><y>0</y><width>1100</width><height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Golden Stay - Laporan Pendapatan</string>
  </property>

  <layout class="QVBoxLayout" name="verticalLayout">
   <property name="spacing"><number>15</number></property>
   <property name="margin"><number>20</number></property>

   <!-- FILTER PERIODE -->
   <item>
    <widget class="QGroupBox" name="group_filter">
     <property name="title">
      <string>Filter Periode Laporan</string>
     </property>
     <layout class="QHBoxLayout">

      <item>
       <widget class="QLabel">
        <property name="text"><string>Dari:</string></property>
       </widget>
      </item>

      <item>
       <widget class="QDateEdit" name="date_start">
        <property name="calendarPopup"><bool>true</bool></property>
       </widget>
      </item>

      <item>
       <widget class="QLabel">
        <property name="text"><string>Sampai:</string></property>
       </widget>
      </item>

      <item>
       <widget class="QDateEdit" name="date_end">
        <property name="calendarPopup"><bool>true</bool></property>
       </widget>
      </item>

      <item>
       <spacer name="horizontalSpacer">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>

      <item>
       <widget class="QPushButton" name="btn_generate">
        <property name="text"><string>📊 Generate Laporan</string></property>
       </widget>
      </item>

      <item>
       <widget class="QPushButton" name="btn_export">
        <property name="text"><string>📕 Export PDF</string></property>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- STAT CARDS -->
   <item>
    <layout class="QHBoxLayout" name="statsLayout">

     <item>
      <widget class="QGroupBox" name="card_total_order">
       <property name="title"><string>Total Pesanan</string></property>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QLabel" name="label_total_order">
          <property name="text"><string>0</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>

     <item>
      <widget class="QGroupBox" name="card_total_income">
       <property name="title"><string>Total Pendapatan</string></property>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QLabel" name="label_total_income">
          <property name="text"><string>Rp 0</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>

     <item>
      <widget class="QGroupBox" name="card_best_room">
       <property name="title"><string>Kamar Terlaris</string></property>
       <layout class="QVBoxLayout">
        <item>
         <widget class="QLabel" name="label_best_room">
          <property name="text"><string>-</string></property>
          <property name="alignment"><set>Qt::AlignCenter</set></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>

    </layout>
   </item>

   <!-- TABLE LAPORAN -->
   <item>
    <widget class="QTableWidget" name="table">
     <property name="columnCount"><number>5</number></property>

     <column><property name="text"><string>ID Laporan</string></property></column>
     <column><property name="text"><string>ID Booking</string></property></column>
     <column><property name="text"><string>ID User</string></property></column>
     <column><property name="text"><string>ID Room</string></property></column>
     <column><property name="text"><string>Pendapatan</string></property></column>

    </widget>
   </item>

  </layout>
 </widget>

